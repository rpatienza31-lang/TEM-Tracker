# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string used by Drizzle (Settings > Database > Connection string > URI)
# Use the "Session pooler" or direct connection string, port 5432/6543 depending on plan.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Disposable database for `npm test` — must contain "test" in its name. Never
# point this at your dev/prod database; the suite truncates tables between runs.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temtracker_test
